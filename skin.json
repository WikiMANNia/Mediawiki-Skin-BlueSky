{
	"name": "BlueSky",
	"version": "1.7.4",
	"author": [
		"wikiHow",
		"Jack Phoenix",
		"Calimonius the Estrange"
	],
	"url": "https://www.mediawiki.org/wiki/Skin:BlueSky",
	"descriptionmsg": "bluesky-desc",
	"namemsg": "skinname-bluesky",
	"license-name": "GPL-2.0-or-later",
	"type": "skin",
	"requires": {
		"MediaWiki": ">=1.39.0"
	},
	"callback": "MediaWiki\\Skin\\BlueSky\\BlueSkyHooks::onRegistration",
	"ValidSkinNames": {
		"bluesky": {
			"class": "SkinTemplate",
			"displayname": "BlueSky",
			"args": [
				{
					"name": "bluesky",
					"bodyOnly": true,
					"responsive": "true",
					"styles": [
						"skins.bluesky",
						"themeloader.skins.bluesky.blue"
					],
					"scripts": [
						"skins.bluesky.js"
					],
					"template": "MediaWiki\\Skin\\BlueSky\\BlueSkyTemplate"
				}
			]
		}
	},
	"attributes": {
		"Theme": {
			"Modules": {
				"bluesky": [
					"blue",
					"red",
					"green",
					"white",
					"grey"
				]
			}
		}
	},
	"MessagesDirs": {
		"SkinBlueSky": [
			"i18n"
		]
	},
	"config": {
		"BlueSkyTOC": {
			"type": "string",
			"value": ""
		}
	},
	"ResourceModules": {
		"skins.bluesky": {
			"targets": [ "desktop", "mobile" ],
			"class": "MediaWiki\\Skin\\BlueSky\\ResourceLoaderSkinModule",
			"features": {
				"content-links": true,
				"logo": true,
				"content-media": true,
				"interface-message-box": true,
				"interface-category": true,
				"content-tables": true,
				"i18n-ordered-lists": true,
				"i18n-all-lists-margins": true,
				"i18n-headings": true
			},
			"styles": {
				"resources/libraries/normalise.css": {
					"media": "screen"
				},
				"resources/styles/print.css": {
					"media": "print"
				}
			}
		},
		"skins.bluesky.js": {
			"targets": [ "desktop" ],
			"scripts": [
				"resources/main.js"
			]
		},
		"themeloader.skins.bluesky.blue": {
			"styles": [
				"resources/theme-blue.less"
			]
		},
		"themeloader.skins.bluesky.green": {
			"styles": [
				"resources/theme-green.less"
			]
		},
		"themeloader.skins.bluesky.red": {
			"styles": [
				"resources/theme-red.less"
			]
		},
		"themeloader.skins.bluesky.white": {
			"styles": [
				"resources/theme-white.less"
			]
		},
		"themeloader.skins.bluesky.grey": {
			"styles": [
				"resources/theme-grey.less"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteSkinPath": "BlueSky"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Skin\\BlueSky\\": "includes/"
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Skin\\BlueSky\\BlueSkyHooks"
		}
	},
	"Hooks": {
		"OutputPageParserOutput": "main"
	},
	"manifest_version": 2
}
